{
  "manifest_version": 3,
  "name": "x-reader",
  "version": "0.1.6",
  "description": "为 X 长文生成可点击的章节目录，让长文章更好读。",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/alexwjj/x-reader",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "x-reader · 长文目录",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "src/content/entry.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/reader.js",
        "src/content/outline.js",
        "src/content/panel.js",
        "src/content/styles.js",
        "src/content/drag.js",
        "src/shared/settings.js"
      ],
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://alexwjj-hub.weightbook.icu/*"
  ]
}
